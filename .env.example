# Copy this file to .env or export these variables in your shell.
# NEVER commit a real API key.

OPENAI_API_KEY=replace_me

# Standard OpenAI API endpoint. Replace only if your university provides a
# different OpenAI-compatible gateway URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Set this to the exact model/deployment name exposed by your account.
NPU_AGENT_MODEL=gpt-5.3-codex

# Use "responses" when the gateway supports /responses.
# Use "chat_completions" when it exposes only /chat/completions.
NPU_AGENT_API_MODE=responses

# Ignore inherited cluster proxy variables by default.
NPU_AGENT_TRUST_ENV=false

# Keep schema-constrained handoffs concise. Supported Responses API values are
# low, medium, and high for models that expose verbosity control.
NPU_AGENT_VERBOSITY=low

# Optional reasoning control when supported by the configured model.
# NPU_AGENT_REASONING_EFFORT=high

# Optional hard cap including visible output and reasoning tokens. Leave unset
# unless an experiment needs an explicit token budget.
# NPU_AGENT_MAX_OUTPUT_TOKENS=20000
