# Copy this file to .env or export these variables in your shell.
# NEVER commit a real API key.

OPENAI_API_KEY=replace_me

# Leave blank for the standard OpenAI API.
# For a university OpenAI-compatible gateway, set the base URL they provide.
# Example shape only: https://your-university-gateway.example.edu/v1
OPENAI_BASE_URL=

# Set this to the exact model/deployment name exposed by your university account.
# If your university exposes a Codex model, use that. Otherwise use the same
# strongest GPT coding-capable model for every agent to keep experiments controlled.
NPU_AGENT_MODEL=gpt-5.3-codex

# Use "responses" when the gateway supports /responses.
# Use "chat_completions" when it exposes only /chat/completions.
NPU_AGENT_API_MODE=responses

# Optional. Remove/comment if the selected model/gateway does not support it.
# NPU_AGENT_REASONING_EFFORT=high
