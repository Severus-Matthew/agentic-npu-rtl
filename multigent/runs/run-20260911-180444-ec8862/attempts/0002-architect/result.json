            "kind": "elementwise_add",
            "semantics": "biased[m,n]=wrap32(dot_accumulators[m,n]+bias[n]). Mandatory.",
            "inputs": [
              "dot_accumulators",
              "bias"
            ],
            "outputs": [
              "biased_results"
            ]
          },
          {
            "name": "relu",
            "kind": "elementwise_activation",
            "semantics": "results[m,n]=0 when biased_results[m,n]<0, otherwise biased_results[m,n]. Mandatory.",
            "inputs": [
              "biased_results"
            ],
            "outputs": [
              "results"
            ]
          }
        ],
