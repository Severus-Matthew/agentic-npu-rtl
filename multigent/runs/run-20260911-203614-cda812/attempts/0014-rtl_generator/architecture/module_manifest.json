        {
          "name": "out_ready",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "downstream ready"
        },
        {
          "name": "out_valid",
          "direction": "output",
          "width": "1",
          "signed": false,
          "semantics": "output valid"
        },
        {
          "name": "out_data",
          "direction": "output",
          "width": "32",
          "signed": true,
