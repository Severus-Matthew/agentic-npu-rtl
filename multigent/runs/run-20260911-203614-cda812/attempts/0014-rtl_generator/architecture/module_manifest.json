    {
      "name": "mv_vec_buffer",
      "responsibility": "store vector and provide 16-lane read slices",
      "dependencies": [],
      "parameters": [
        "MAX_N",
        "LANES"
      ],
      "stateful": true,
      "ports": [
        {
          "name": "clk",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "clock"
        },
        {
          "name": "rst_n",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "reset valid metadata"
        },
        {
          "name": "wr_en",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "write enable on vec transfer"
        },
        {
          "name": "wr_addr",
          "direction": "input",
          "width": "$clog2(MAX_N)",
          "signed": false,
          "semantics": "vector write index"
        },
        {
          "name": "wr_data",
          "direction": "input",
          "width": "8",
          "signed": true,
          "semantics": "vector element"
        },
        {
          "name": "rd_chunk_base",
          "direction": "input",
          "width": "$clog2(MAX_N)",
          "signed": false,
          "semantics": "base k index for lane0"
        },
        {
          "name": "rd_data",
          "direction": "output",
          "width": "LANES*8",
          "signed": true,
          "semantics": "concatenated 16 INT8 lane values, combinational read"
        }
      ]
    },
    {
      "name": "mv_mac16_core",
      "responsibility": "16-lane multiply and reduction with row accumulator",
      "dependencies": [],
