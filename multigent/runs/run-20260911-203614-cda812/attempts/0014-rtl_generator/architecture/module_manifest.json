        {
          "name": "mat_lane_data",
          "direction": "input",
          "width": "LANES*8",
          "signed": true,
          "semantics": "16 matrix INT8 values"
        },
        {
          "name": "vec_lane_data",
          "direction": "input",
          "width": "LANES*8",
          "signed": true,
          "semantics": "16 vector INT8 values"
        },
        {
          "name": "row_accum_out",
          "direction": "output",
          "width": "32",
          "signed": true,
          "semantics": "current accumulated row sum"
        },
        {
          "name": "row_done_pulse",
          "direction": "output",
          "width": "1",
          "signed": false,
          "semantics": "pulse when final chunk accumulated"
        }
      ]
    },
