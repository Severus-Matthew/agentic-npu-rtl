        },
        {
          "name": "start_out",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "start streaming"
        },
        {
          "name": "out_rd_addr",
          "direction": "output",
          "width": "$clog2(M_MAX*N_MAX)",
          "signed": false,
          "semantics": "sequential read address"
        },
        {
          "name": "out_rd_data",
          "direction": "input",
          "width": "ACC_W",
          "signed": true,
          "semantics": "output memory read data, 1-cycle after addr"
        },
        {
          "name": "m_valid",
          "direction": "output",
          "width": "1",
          "signed": false,
          "semantics": "output valid"
        },
        {
          "name": "m_ready",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "output ready"
        },
        {
          "name": "m_data",
          "direction": "output",
          "width": "ACC_W",
          "signed": true,
          "semantics": "output payload stable while stalled"
        },
        {
          "name": "out_done",
          "direction": "output",
          "width": "1",
          "signed": false,
          "semantics": "1-cycle pulse on last handshake"
        }
      ]
    },
