            }
          },
          "guards": [],
          "field_binding_origin": "verifier_declared",
          "observer": "observe_reset",
          "field_types": {}
        }
      },
      "bins": [
        {
          "name": "empty_reset",
          "intent": "Reset sampled with no pending result.",
          "predicate": {
            "op": "eq",
            "args": [
              0
            ]
          }
        },
        {
          "name": "pending_abort",
          "intent": "Reset sampled while a registered result is pending.",
          "predicate": {
            "op": "eq",
            "args": [
              1
            ]
          }
        }
      ],
      "checks": []
