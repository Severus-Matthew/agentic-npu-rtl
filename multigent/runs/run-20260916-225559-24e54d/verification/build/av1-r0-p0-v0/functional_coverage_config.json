{
  "schema_version": 3,
  "source": "interface taxonomy + verifier operation coverage",
  "monitor": {
    "clock": "clk",
    "reset": "rst_n",
    "signals": [
      "clk",
      "rst_n",
      "in_valid",
      "in_ready",
      "in_a",
      "in_b",
      "out_valid",
      "out_ready",
      "out_sum"
    ]
  },
  "obligations": [
    {
      "id": "channel.input_pair.handshake_states",
      "template": "handshake_states",
      "scope": "channel",
      "scope_name": "input_pair",
      "description": "Cover all producer-valid and consumer-ready states.",
      "bindings": {
        "valid": "in_valid",
        "ready": "in_ready"
      },
      "bins": [
        {
          "name": "idle",
          "intent": "valid=0 and ready=0"
        },
        {
          "name": "receiver_ready",
          "intent": "valid=0 and ready=1"
        },
        {
          "name": "backpressured",
          "intent": "valid=1 and ready=0"
        },
        {
          "name": "transfer",
          "intent": "valid=1 and ready=1"
        }
      ]
    },
    {
      "id": "channel.input_pair.stall_stability",
      "template": "stall_stability",
      "scope": "channel",
      "scope_name": "input_pair",
      "description": "Exercise a stalled transfer and hold all producer-owned content stable.",
      "bindings": {
        "valid": "in_valid",
        "ready": "in_ready",
        "payload": [
          "in_a",
          "in_b"
        ]
      },
      "bins": [
        {
          "name": "one_cycle_stall",
          "intent": "Observe exactly one stalled cycle."
        },
        {
          "name": "short_stall",
          "intent": "Observe two through four consecutive stalled cycles."
        },
        {
          "name": "long_stall",
          "intent": "Observe five or more consecutive stalled cycles."
        }
      ]
    },
    {
      "id": "channel.output_sum.handshake_states",
      "template": "handshake_states",
      "scope": "channel",
      "scope_name": "output_sum",
      "description": "Cover all producer-valid and consumer-ready states.",
      "bindings": {
        "valid": "out_valid",
        "ready": "out_ready"
      },
      "bins": [
        {
          "name": "idle",
          "intent": "valid=0 and ready=0"
        },
        {
          "name": "receiver_ready",
          "intent": "valid=0 and ready=1"
        },
        {
          "name": "backpressured",
          "intent": "valid=1 and ready=0"
        },
        {
          "name": "transfer",
          "intent": "valid=1 and ready=1"
        }
      ]
    },
    {
      "id": "channel.output_sum.stall_stability",
      "template": "stall_stability",
      "scope": "channel",
      "scope_name": "output_sum",
      "description": "Exercise a stalled transfer and hold all producer-owned content stable.",
      "bindings": {
        "valid": "out_valid",
        "ready": "out_ready",
        "payload": [
          "out_sum"
        ]
      },
      "bins": [
        {
          "name": "one_cycle_stall",
          "intent": "Observe exactly one stalled cycle."
        },
        {
          "name": "short_stall",
          "intent": "Observe two through four consecutive stalled cycles."
        },
        {
          "name": "long_stall",
          "intent": "Observe five or more consecutive stalled cycles."
        }
      ]
    },
    {
      "id": "operation.add.carry_boundary",
      "template": "operation_coverpoint",
      "scope": "operation",
      "scope_name": "add",
      "kind": "coverpoint",
      "description": "Carry classification from both actually accepted operands.",
      "bindings": {
        "operation_name": "add",
        "family": "scalar_unsigned_addition",
        "field": "accepted_mathematical_sum",
        "concept": "carry_boundary",
        "source": "baseline",
        "sampling": {
          "template": "custom",
          "event": "transfer",
          "channel": {
            "valid": "in_valid",
            "ready": "in_ready"
          },
          "fields": {
            "a": {
              "signal": "in_a",
              "lsb": 0,
              "width": null,
              "declared_width": 8
            },
            "b": {
              "signal": "in_b",
              "lsb": 0,
              "width": null,
              "declared_width": 8
            }
          },
          "guards": [],
          "field_binding_origin": "verifier_declared",
          "observer": "observe_carry",
          "field_types": {}
        }
      },
      "bins": [
        {
          "name": "below_boundary",
          "intent": "No carry, below the adjacent boundary.",
          "predicate": {
            "op": "lt",
            "args": [
              255
            ]
          }
        },
        {
          "name": "boundary_minus_one",
          "intent": "255 exact.",
          "predicate": {
            "op": "eq",
            "args": [
              255
            ]
          }
        },
        {
          "name": "boundary",
          "intent": "256 exact.",
          "predicate": {
            "op": "eq",
            "args": [
              256
            ]
          }
        },
        {
          "name": "above_boundary",
          "intent": "Carry with additional low bits.",
          "predicate": {
            "op": "gt",
            "args": [
              256
            ]
          }
        }
      ],
      "checks": []
    },
    {
      "id": "operation.add.exact_widened_sum",
      "template": "operation_coverpoint",
      "scope": "operation",
      "scope_name": "add",
      "kind": "coverpoint",
      "description": "Transferred result magnitude; each result is independently checked against its accepted pair.",
      "bindings": {
        "operation_name": "add",
        "family": "scalar_unsigned_addition",
        "field": "transferred_sum",
        "concept": "exact_widened_sum",
        "source": "baseline",
        "sampling": {
          "template": "custom",
          "event": "transfer",
          "channel": {
            "valid": "out_valid",
            "ready": "out_ready"
          },
          "fields": {
            "sum": {
              "signal": "out_sum",
              "lsb": 0,
              "width": null,
              "declared_width": 9
            }
          },
          "guards": [],
          "field_binding_origin": "verifier_declared",
          "observer": "observe_sum",
          "field_types": {}
        }
      },
      "bins": [
        {
          "name": "zero",
          "intent": "Minimum exact result.",
          "predicate": {
            "op": "eq",
            "args": [
              0
            ]
          }
        },
        {
          "name": "low_interior",
          "intent": "Below the carry boundary.",
          "predicate": {
            "op": "between",
            "args": [
              1,
              254
            ]
          }
        },
        {
          "name": "last_eight_bit",
          "intent": "Largest eight-bit result.",
          "predicate": {
            "op": "eq",
            "args": [
              255
            ]
          }
        },
        {
          "name": "first_nine_bit",
          "intent": "First result requiring bit eight.",
          "predicate": {
            "op": "eq",
            "args": [
              256
            ]
          }
        },
        {
          "name": "high_interior",
          "intent": "Widened nonmaximum result.",
          "predicate": {
            "op": "between",
            "args": [
              257,
              509
            ]
          }
        },
        {
          "name": "maximum",
          "intent": "Maximum mathematical result.",
          "predicate": {
            "op": "eq",
            "args": [
              510
            ]
          }
        }
      ],
      "checks": []
    },
    {
      "id": "operation.add.operand_a",
      "template": "operation_coverpoint",
      "scope": "operation",
      "scope_name": "add",
      "kind": "coverpoint",
