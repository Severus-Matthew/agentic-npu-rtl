          "name": "rst_n",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "reset"
        },
        {
          "name": "enable_compute",
          "direction": "input",
          "width": "1",
          "signed": false,
          "semantics": "active during compute phase"
