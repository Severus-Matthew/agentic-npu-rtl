        {
          "name": "wdata_c",
          "direction": "input",
          "width": "32",
          "signed": true,
          "semantics": "C write data"
        },
        {
          "name": "raddr_c",
          "direction": "input",
          "width": "6",
          "signed": false,
          "semantics": "output read addr"
        },
        {
          "name": "rdata_c",
          "direction": "output",
          "width": "32",
          "signed": true,
          "semantics": "C read data, 1-cycle sync read latency"
