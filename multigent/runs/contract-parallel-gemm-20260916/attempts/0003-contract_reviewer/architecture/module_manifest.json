          "name": "raddr_a",
          "direction": "input",
          "width": "8",
          "signed": false,
          "semantics": "compute/read addr A"
        },
        {
          "name": "rdata_a",
          "direction": "output",
          "width": "8",
          "signed": true,
          "semantics": "A read data, 1-cycle sync read latency"
        },
        {
          "name": "raddr_b",
          "direction": "input",
          "width": "8",
          "signed": false,
          "semantics": "compute/read addr B"
        },
        {
          "name": "rdata_b",
          "direction": "output",
          "width": "8",
          "signed": true,
