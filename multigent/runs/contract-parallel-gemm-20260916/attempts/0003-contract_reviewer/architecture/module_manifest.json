        {
          "name": "raddr_a",
          "direction": "output",
          "width": "8",
          "signed": false,
          "semantics": "A read addr"
        },
        {
          "name": "rdata_a",
          "direction": "input",
          "width": "8",
          "signed": true,
          "semantics": "A read data"
        },
        {
          "name": "raddr_b",
          "direction": "output",
          "width": "8",
          "signed": false,
          "semantics": "B read addr"
        },
        {
          "name": "rdata_b",
          "direction": "input",
          "width": "8",
          "signed": true,
          "semantics": "B read data"
        },
        {
          "name": "raddr_bias",
          "direction": "output",
          "width": "3",
          "signed": false,
          "semantics": "bias read addr"
        },
        {
          "name": "rdata_bias",
          "direction": "input",
          "width": "32",
          "signed": true,
          "semantics": "bias read data"
        },
        {
          "name": "we_c",
          "direction": "output",
          "width": "1",
          "signed": false,
          "semantics": "C write enable pulse when one output finalized"
        },
        {
          "name": "waddr_c",
          "direction": "output",
          "width": "6",
          "signed": false,
          "semantics": "C write addr row-major"
        },
        {
          "name": "wdata_c",
          "direction": "output",
          "width": "32",
          "signed": true,
          "semantics": "C write data after ReLU"
        },
        {
          "name": "compute_done",
          "direction": "output",
          "width": "1",
          "signed": false,
          "semantics": "one-cycle pulse after C[63] written"
        }
