{
  "status": "READY",
  "conflicts": [],
  "architecture_contract": {
    "design": {
      "name": "gemm_bias_relu_npu",
      "version": "1.0",
      "description": "Parameterized int8 GEMM with int32 bias add and ReLU output using ready/valid streaming interfaces and tiled local accumulation."
    },
    "operations": [
      {
        "name": "load_config",
        "kind": "control",
        "semantics": "Latch per-job dimensions M,N,K from command channel when accepted in IDLE state.",
        "inputs": [
          "cfg_cmd"
        ],
        "outputs": [
          "cfg_state"
        ]
      },
      {
        "name": "gemm_core",
        "kind": "compute",
        "semantics": "For each output element C[m,n], compute sum over k: acc32=\u03a3(A[m,k]*B[k,n]) where A and B are signed int8, product is signed int16, accumulation is signed int32 with two's-complement wrap on overflow.",
        "inputs": [
          "tensor_a",
          "tensor_b",
          "cfg_state"
        ],
        "outputs": [
          "acc_tensor"
        ]
      },
      {
        "name": "bias_add",
        "kind": "compute",
        "semantics": "For each C[m,n], add signed int32 bias[n] to acc32 using signed int32 two's-complement wrap.",
        "inputs": [
          "acc_tensor",
          "bias_vec",
          "cfg_state"
        ],
        "outputs": [
          "biased_tensor"
        ]
      },
      {
        "name": "relu",
        "kind": "compute",
        "semantics": "For each element x in biased_tensor, output max(x,0) in signed int32.",
        "inputs": [
          "biased_tensor"
        ],
        "outputs": [
          "output_tensor"
        ]
      }
    ],
    "data_types": [
      {
        "name": "sint8",
        "role": "A/B elements",
        "width_bits": 8,
        "signed": true,
        "representation": "two_complement",
        "conversion_semantics": "sign-extend when widened",
        "overflow_semantics": "wrap",
        "rounding_semantics": "not_applicable"
      },
      {
        "name": "sint16",
        "role": "product intermediate",
        "width_bits": 16,
        "signed": true,
        "representation": "two_complement",
        "conversion_semantics": "exact from sint8*sint8",
        "overflow_semantics": "wrap",
        "rounding_semantics": "not_applicable"
      },
      {
        "name": "sint32",
        "role": "accumulator/bias/output",
        "width_bits": 32,
        "signed": true,
        "representation": "two_complement",
        "conversion_semantics": "sign-extend from narrower signed types",
        "overflow_semantics": "wrap",
        "rounding_semantics": "not_applicable"
      },
      {
        "name": "u16",
        "role": "runtime dimensions",
        "width_bits": 16,
        "signed": false,
        "representation": "unsigned_binary",
        "conversion_semantics": "exact",
        "overflow_semantics": "illegal_if_out_of_range",
        "rounding_semantics": "not_applicable"
      }
    ],
    "data_objects": [
      {
        "name": "cfg_cmd",
        "role": "job configuration {M,N,K}",
        "data_type": "u16",
        "dimensions": [
          "cfg_fields"
        ],
        "producer": "external",
        "consumers": [
          "load_config"
        ],
        "external": true
      },
      {
        "name": "cfg_state",
        "role": "latched active job dimensions",
        "data_type": "u16",
        "dimensions": [
          "cfg_fields"
        ],
        "producer": "load_config",
        "consumers": [
          "gemm_core",
          "bias_add"
        ],
        "external": false
      },
      {
        "name": "tensor_a",
        "role": "A matrix stream",
        "data_type": "sint8",
        "dimensions": [
          "M",
          "K"
        ],
        "producer": "external",
        "consumers": [
          "gemm_core"
        ],
        "external": true
      },
      {
        "name": "tensor_b",
        "role": "B matrix stream",
        "data_type": "sint8",
        "dimensions": [
          "K",
          "N"
        ],
        "producer": "external",
        "consumers": [
          "gemm_core"
        ],
        "external": true
      },
      {
        "name": "bias_vec",
        "role": "per-output-column bias",
        "data_type": "sint32",
        "dimensions": [
          "N"
        ],
        "producer": "external",
        "consumers": [
          "bias_add"
        ],
        "external": true
      },
      {
        "name": "acc_tensor",
        "role": "GEMM accumulation result",
        "data_type": "sint32",
        "dimensions": [
          "M",
          "N"
        ],
        "producer": "gemm_core",
        "consumers": [
          "bias_add"
        ],
        "external": false
      },
      {
        "name": "biased_tensor",
        "role": "post-bias tensor",
        "data_type": "sint32",
        "dimensions": [
          "M",
          "N"
        ],
        "producer": "bias_add",
        "consumers": [
          "relu"
        ],
        "external": false
      },
      {
        "name": "output_tensor",
        "role": "final ReLU outputs",
        "data_type": "sint32",
        "dimensions": [
          "M",
          "N"
        ],
        "producer": "relu",
        "consumers": [
          "external"
        ],
        "external": true
      }
    ],
    "dimensions": [
      {
        "name": "M",
        "semantic": "output rows / A rows",
        "minimum": 1,
        "maximum": 256,
        "runtime_configurable": true,
        "bound_parameter": "MAX_M"
      },
      {
        "name": "N",
        "semantic": "output cols / B cols / bias length",
        "minimum": 1,
        "maximum": 256,
        "runtime_configurable": true,
        "bound_parameter": "MAX_N"
      },
      {
        "name": "K",
        "semantic": "reduction length / A cols / B rows",
        "minimum": 1,
        "maximum": 256,
        "runtime_configurable": true,
        "bound_parameter": "MAX_K"
      },
      {
        "name": "cfg_fields",
        "semantic": "number of config scalars {M,N,K}",
        "minimum": 3,
        "maximum": 3,
        "runtime_configurable": false,
        "bound_parameter": "CFG_FIELDS"
      }
    ],
    "parameters": [
      {
        "name": "MAX_M",
        "default_value": "64",
        "legality_constraint": "integer >=1 and <=256",
        "description": "maximum supported runtime M"
      },
      {
        "name": "MAX_N",
        "default_value": "64",
        "legality_constraint": "integer >=1 and <=256",
        "description": "maximum supported runtime N"
      },
      {
        "name": "MAX_K",
        "default_value": "64",
        "legality_constraint": "integer >=1 and <=256",
        "description": "maximum supported runtime K"
      },
      {
        "name": "TILE_M",
        "default_value": "4",
        "legality_constraint": "integer >=1 and <=MAX_M",
        "description": "rows computed per tile"
      },
      {
        "name": "TILE_N",
        "default_value": "4",
        "legality_constraint": "integer >=1 and <=MAX_N",
        "description": "cols computed per tile"
      },
      {
        "name": "CFG_FIELDS",
        "default_value": "3",
        "legality_constraint": "must equal 3",
        "description": "config field count"
      },
      {
        "name": "CMD_W",
        "default_value": "48",
        "legality_constraint": "must be >=48",
        "description": "command payload width; packs M,N,K as 3x16b"
      },
      {
        "name": "A_W",
        "default_value": "8",
        "legality_constraint": "must equal 8",
        "description": "A stream payload width"
      },
      {
        "name": "B_W",
        "default_value": "8",
        "legality_constraint": "must equal 8",
        "description": "B stream payload width"
      },
      {
        "name": "BIAS_W",
        "default_value": "32",
        "legality_constraint": "must equal 32",
        "description": "bias stream payload width"
      },
      {
        "name": "OUT_W",
        "default_value": "32",
        "legality_constraint": "must equal 32",
        "description": "output stream payload width"
      }
    ],
    "compute": {
      "organization": "single-core tiled MAC engine with TILE_M x TILE_N parallel accumulators",
      "dataflow": "output-stationary within a tile; K streamed across stationary accumulators",
      "parallelism": "spatial parallelism TILE_M*TILE_N MACs/cycle during steady compute",
      "scheduling": "phase schedule per job: load bias tile, for each m-tile and n-tile run K-step MAC loop, then bias+ReLU and emit; edge tiles masked for non-multiples"
    },
    "storage": [
      {
        "name": "bias_sram",
        "stored_objects": [
          "bias_vec"
        ],
        "capacity_expression": "MAX_N elements of sint32",
        "capacity_at_default_parameters": 64,
        "access_pattern": "sequential write during bias load; random read by n index during output finalize",
        "port_requirements": "1R1W or time-multiplexed single-port with non-overlap",
        "implementation_hint": "small SRAM or register file",
        "reuse_semantics": "loaded once per job and reused across all M rows",
        "lifetime": "from bias load completion until job done"
      },
      {
        "name": "acc_tile_regs",
        "stored_objects": [
          "acc_tensor"
        ],
        "capacity_expression": "TILE_M*TILE_N elements of sint32",
        "capacity_at_default_parameters": 16,
        "access_pattern": "per-cycle read-modify-write during K loop",
        "port_requirements": "TILE_M*TILE_N parallel RMW lanes",
        "implementation_hint": "register array",
        "reuse_semantics": "cleared at tile start; holds partial sums across K",
        "lifetime": "one output tile"
      },
      {
        "name": "a_lane_regs",
        "stored_objects": [
          "tensor_a"
        ],
        "capacity_expression": "TILE_M elements of sint8",
        "capacity_at_default_parameters": 4,
        "access_pattern": "loaded each K step then broadcast across N lanes",
        "port_requirements": "TILE_M write + TILE_M*TILE_N read fanout",
        "implementation_hint": "registers",
        "reuse_semantics": "used for one K step",
        "lifetime": "one inner-loop iteration"
      },
      {
        "name": "b_lane_regs",
        "stored_objects": [
          "tensor_b"
        ],
        "capacity_expression": "TILE_N elements of sint8",
        "capacity_at_default_parameters": 4,
        "access_pattern": "loaded each K step then broadcast across M lanes",
        "port_requirements": "TILE_N write + TILE_M*TILE_N read fanout",
        "implementation_hint": "registers",
        "reuse_semantics": "used for one K step",
        "lifetime": "one inner-loop iteration"
      }
    ],
    "pipeline": [
      {
        "stage": "S0_cmd",
        "responsibility": "accept and validate command in IDLE",
        "registered": true,
        "valid_behavior": "latch cfg when cmd_valid&&cmd_ready",
        "stall_behavior": "cmd_ready deasserted outside IDLE"
      },
      {
        "stage": "S1_load",
        "responsibility": "ingest bias then operand streams for active tiles",
        "registered": true,
        "valid_behavior": "advance only on stream ready&&valid handshakes",
        "stall_behavior": "hold indices and partial state when any required input beat missing"
      },
      {
        "stage": "S2_mac",
        "responsibility": "parallel multiply-accumulate update for active tile",
        "registered": true,
        "valid_behavior": "on each accepted K-step operands, update enabled accumulators",
        "stall_behavior": "no state change without accepted operand set"
      },
      {
        "stage": "S3_post",
        "responsibility": "bias add and ReLU on finalized tile elements",
        "registered": true,
        "valid_behavior": "compute one or more outputs when downstream can accept",
        "stall_behavior": "hold output data/valid stable under backpressure"
      },
      {
        "stage": "S4_out",
        "responsibility": "stream output elements with framing",
        "registered": true,
        "valid_behavior": "emit in tile-major deterministic order on ready&&valid",
        "stall_behavior": "retain current output element and metadata until transfer"
      }
    ],
    "control": {
      "strategy": "central FSM with nested counters",
      "state_progression": "IDLE->LOAD_BIAS->COMPUTE_TILES->EMIT_TILE->DONE->IDLE",
      "counters": [
        "m_idx:0..M-1",
        "n_idx:0..N-1",
        "k_idx:0..K-1",
        "tm_idx:0..TILE_M-1",
        "tn_idx:0..TILE_N-1"
      ],
      "error_behavior": "illegal dimension (0 or >max) or protocol violation sets error flag and transitions to DONE with status error, suppressing output_valid",
      "error_recovery": "host issues new valid command while in IDLE after done_status observed; new command clears error flag and restarts"
    },
    "reset": {
      "style": "synchronous",
      "polarity": "active_low",
      "required_state": "FSM=IDLE, counters=0, valids=0, done=0, error=0, cfg invalid"
    },
    "latency_model": "Cycles = 1(cmd)+N(bias load)+ceil(M/TILE_M)*ceil(N/TILE_N)*(K + valid_outputs_per_tile) plus backpressure stalls; no overlap between bias load and compute; compute stalls if required operand beats not available.",
    "architectural_invariants": [
      "Runtime dimensions must satisfy 1<=M<=MAX_M, 1<=N<=MAX_N, 1<=K<=MAX_K.",
      "One output element equals ReLU((\u03a3_k A[m,k]*B[k,n]) + bias[n]) in signed int32 wrap arithmetic.",
      "Outputs emitted in tile-major order: tile_m outer, tile_n inner, then row-major within tile with masked edges skipped.",
      "All ready/valid channels transfer only when ready&&valid; payload stable while valid&& !ready."
    ],
    "open_assumptions": [
      "Simple single-job in-flight model (no command queue).",
      "Host provides A and B streams in exact compute-consumption order required by tile/K traversal.",
      "Bias is provided once per job before compute and fully retained locally.",
      "No quantization/scaling beyond requested int8/int32 arithmetic."
    ]
  },
  "interface_contract": {
    "protocol": "AXI-stream-like ready/valid discrete channels",
    "clock": "single rising-edge clock",
    "reset": "active-low synchronous reset",
    "channels": [
      {
        "name": "cmd",
        "direction": "input",
        "purpose": "job configuration",
        "data_objects": [
          "cfg_cmd"
        ],
        "metadata": [
          "cmd_valid",
          "cmd_ready"
        ],
        "framing": "single beat per job; bits[15:0]=M bits[31:16]=N bits[47:32]=K",
        "ordering": "one command only accepted in IDLE",
        "backpressure": "supported via cmd_ready"
      },
      {
        "name": "a_in",
        "direction": "input",
        "purpose": "A operand stream",
        "data_objects": [
          "tensor_a"
        ],
        "metadata": [
          "a_valid",
          "a_ready"
        ],
        "framing": "one int8 element per beat in bits[7:0]",
        "ordering": "for each tile_m, tile_n, and each k: send rows r=0..TILE_M-1 for global row m=tile_m*TILE_M+r when m<M; skip invalid edge rows",
        "backpressure": "supported"
      },
      {
        "name": "b_in",
        "direction": "input",
        "purpose": "B operand stream",
        "data_objects": [
          "tensor_b"
        ],
        "metadata": [
          "b_valid",
          "b_ready"
        ],
        "framing": "one int8 element per beat in bits[7:0]",
        "ordering": "for each tile_m, tile_n, and each k: send cols c=0..TILE_N-1 for global col n=tile_n*TILE_N+c when n<N; skip invalid edge cols",
        "backpressure": "supported"
      },
      {
        "name": "bias_in",
        "direction": "input",
        "purpose": "bias vector stream",
        "data_objects": [
          "bias_vec"
        ],
        "metadata": [
          "bias_valid",
          "bias_ready"
        ],
        "framing": "one int32 element per beat bits[31:0]",
        "ordering": "n=0..N-1 exactly once after command and before compute",
        "backpressure": "supported"
      },
      {
        "name": "out",
        "direction": "output",
        "purpose": "final result stream",
        "data_objects": [
          "output_tensor"
        ],
        "metadata": [
          "out_valid",
          "out_ready",
          "out_last",
          "out_user_err"
        ],
        "framing": "one int32 per beat bits[31:0]; out_last asserted on final element of job",
        "ordering": "tile-major deterministic order matching architecture invariant",
        "backpressure": "supported"
      },
      {
        "name": "status",
        "direction": "output",
        "purpose": "job completion",
        "data_objects": [],
        "metadata": [
          "done_valid",
          "done_ready",
          "done_error"
        ],
        "framing": "single beat at job end",
        "ordering": "exactly one status beat per accepted command",
        "backpressure": "supported"
      }
    ],
    "signals": [
      {
        "name": "clk",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "system clock",
        "reset_value": "0"
      },
      {
        "name": "rst_n",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "active-low synchronous reset",
        "reset_value": "0"
      },
      {
        "name": "cmd_valid",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "command valid",
        "reset_value": "0"
      },
      {
        "name": "cmd_ready",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "command ready",
        "reset_value": "0"
      },
      {
        "name": "cmd_data",
        "direction": "input",
        "width": "CMD_W",
        "signed": false,
        "semantic": "packed M,N,K",
        "reset_value": "0"
      },
      {
        "name": "a_valid",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "A beat valid",
        "reset_value": "0"
      },
      {
        "name": "a_ready",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "A beat ready",
        "reset_value": "0"
      },
      {
        "name": "a_data",
        "direction": "input",
        "width": "A_W",
        "signed": true,
        "semantic": "A element",
        "reset_value": "0"
      },
      {
        "name": "b_valid",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "B beat valid",
        "reset_value": "0"
      },
      {
        "name": "b_ready",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "B beat ready",
        "reset_value": "0"
      },
      {
        "name": "b_data",
        "direction": "input",
        "width": "B_W",
        "signed": true,
        "semantic": "B element",
        "reset_value": "0"
      },
      {
        "name": "bias_valid",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "bias beat valid",
        "reset_value": "0"
      },
      {
        "name": "bias_ready",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "bias beat ready",
        "reset_value": "0"
      },
      {
        "name": "bias_data",
        "direction": "input",
        "width": "BIAS_W",
        "signed": true,
        "semantic": "bias element",
        "reset_value": "0"
      },
      {
        "name": "out_valid",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "output valid",
        "reset_value": "0"
      },
      {
        "name": "out_ready",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "output ready",
        "reset_value": "0"
      },
      {
        "name": "out_data",
        "direction": "output",
        "width": "OUT_W",
        "signed": true,
        "semantic": "output element",
        "reset_value": "0"
      },
      {
        "name": "out_last",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "final output beat marker",
        "reset_value": "0"
      },
      {
        "name": "out_user_err",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "error marker (1 if job failed)",
        "reset_value": "0"
      },
      {
        "name": "done_valid",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "status valid",
        "reset_value": "0"
      },
      {
        "name": "done_ready",
        "direction": "input",
        "width": "1",
        "signed": false,
        "semantic": "status ready",
        "reset_value": "0"
      },
      {
        "name": "done_error",
        "direction": "output",
        "width": "1",
        "signed": false,
        "semantic": "status error flag",
        "reset_value": "0"
      }
    ],
    "global_handshake_rules": {
      "transfer_condition": "A channel transfer occurs iff ready && valid on same cycle.",
      "stall_behavior": "While valid=1 and ready=0, payload and sideband metadata must remain stable until transfer."
    }
  },
  "module_manifest": {
    "top": "gemm_bias_relu_npu_top",
    "modules": [
      {
        "name": "gemm_bias_relu_npu_top",
        "responsibility": "top integration, interface termination, global FSM, status generation",
        "dependencies": [
          "cfg_unit",
          "stream_ingress",
          "mac_tile_core",
          "postproc_unit",
          "egress_unit"
        ],
        "parameters": [
          "MAX_M",
          "MAX_N",
          "MAX_K",
          "TILE_M",
          "TILE_N",
          "CFG_FIELDS",
          "CMD_W",
          "A_W",
          "B_W",
          "BIAS_W",
          "OUT_W"
        ],
        "stateful": true
      },
      {
        "name": "cfg_unit",
        "responsibility": "decode/validate command and hold runtime dimensions",
        "dependencies": [],
        "parameters": [
          "MAX_M",
          "MAX_N",
          "MAX_K",
          "CMD_W"
        ],
        "stateful": true
      },
      {
        "name": "stream_ingress",
        "responsibility": "accept bias/A/B streams and present lane operands per schedule",
        "dependencies": [],
        "parameters": [
          "TILE_M",
          "TILE_N",
          "A_W",
          "B_W",
          "BIAS_W",
          "MAX_N"
        ],
        "stateful": true
      },
      {
        "name": "mac_tile_core",
        "responsibility": "TILE_M x TILE_N int8 MAC accumulation across K",
        "dependencies": [],
        "parameters": [
          "TILE_M",
          "TILE_N"
        ],
        "stateful": true
      },
      {
        "name": "postproc_unit",
        "responsibility": "bias add and ReLU for finalized tile accumulators",
        "dependencies": [],
        "parameters": [
          "TILE_M",
          "TILE_N"
        ],
        "stateful": false
      },
      {
        "name": "egress_unit",
        "responsibility": "ordered output streaming and done signaling",
        "dependencies": [],
        "parameters": [
          "TILE_M",
          "TILE_N",
          "OUT_W"
        ],
        "stateful": true
      }
    ]
  },
  "acceptance_criteria": {
    "functional": [
      "For every legal M,N,K and inputs A,B,bias, output stream equals software reference ReLU((A*B)+bias) with signed int32 wrap arithmetic.",
      "Bias index is column-wise: bias[n] added to all rows m for fixed n.",
      "Edge tiles (when M or N not divisible by tile sizes) produce only legal indices with no extra outputs."
    ],
    "verification": [
      "Minimum 100 randomized legal transactions across varying M,N,K including boundary values 1 and MAX_*.",
      "Reset test required: asserting/deasserting rst_n returns interface/control to required reset state before next command.",
      "Backpressure tests required on all ready/valid inputs and outputs with random stalls; no data loss/duplication.",
      "Protocol-negative tests: illegal dimensions (0 or >max) must produce done_error=1 and no output data."
    ],
    "rtl": [
      "SystemVerilog synthesizable subset only; no real/shortreal/delay/force-release/classes.",
      "No combinational loops; sequential state updates on clk edge with synchronous active-low reset behavior as specified.",
      "Payload stability under stall must be provable by assertions on each valid/ready channel."
    ],
    "synopsys_handoff": [
      "Synthesis/timing/power/area/frequency/utilization claims accepted only from deterministic Synopsys tool reports conforming to multigent/schemas/synthesis_result.schema.json.",
      "No estimated or inferred PPA metrics allowed without authoritative deterministic report.",
      "Handoff requires verified RTL passing functional and protocol acceptance criteria prior to Synopsys runs."
    ]
  }
}
