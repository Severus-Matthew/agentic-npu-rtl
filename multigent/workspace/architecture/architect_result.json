  "acceptance_criteria": {
    "functional": [
      "For each legal M,N,K, output C equals int32(ReLU((A*B)+bias)) per command enables, exact integer semantics.",
      "When bias_enable=0, bias input section is not required and bias term treated as zero.",
      "When relu_enable=0, negative outputs are preserved."
    ],
    "verification": [
      "Minimum 100 randomized jobs across legal bounds with software golden model comparison.",
      "Directed boundary tests: M/N/K at 1 and at MAX_M/MAX_N/MAX_K, plus N not divisible by LANES_N.",
      "Reset tests required: reset during IDLE and mid-job; post-reset first job must execute correctly.",
