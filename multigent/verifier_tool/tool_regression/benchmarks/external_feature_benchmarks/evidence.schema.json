{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external-feature-benchmark-evidence.schema.json",
  "title": "External feature-extension benchmark evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "source_revision",
    "frozen_contract_sha256",
    "generated_tb_sha256",
    "upstream_baseline",
    "clean_generated_tb",
    "positive_controls",
    "obligations",
    "known_mutants",
    "holdout_mutants",
    "verdict"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[PLO][0-9]{2}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frozen_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_tb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "upstream_baseline": {"$ref": "#/$defs/run"},
    "clean_generated_tb": {"$ref": "#/$defs/run"},
    "positive_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "passed": {"type": "integer", "minimum": 0}
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "resolved", "executed"],
      "properties": {
        "required": {"type": "integer", "minimum": 1},
        "resolved": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0}
      }
    },
    "known_mutants": {"$ref": "#/$defs/mutation_summary"},
    "holdout_mutants": {"$ref": "#/$defs/mutation_summary"},
    "verifier_attempts": {"type": "integer", "minimum": 0},
    "human_code_edits": {"type": "integer", "minimum": 0},
    "reused_helpers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "notes": {"type": "string"},
    "verdict": {"enum": ["PASS", "FAIL", "BLOCKED"]}
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "command", "evidence"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
        "command": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "mutation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "detected", "correct_diagnostic"],
      "properties": {
        "total": {"type": "integer", "minimum": 1},
        "detected": {"type": "integer", "minimum": 0},
        "correct_diagnostic": {"type": "integer", "minimum": 0},
        "timeouts": {"type": "integer", "minimum": 0},
        "driver_rejections": {"type": "integer", "minimum": 0}
      }
    }
  }
}
