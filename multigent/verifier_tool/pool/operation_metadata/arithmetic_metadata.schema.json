{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architect-declared operation arithmetic",
  "description": "Select a supported exact arithmetic profile, or explicitly delegate unsupported semantics. Type and dimension names reference the existing architecture contract.",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifier_profile", "product_data_type", "accumulator_data_type", "accumulator_initialization", "reduction_dimensions", "reduction_order", "reduction_conversion", "post_operations", "post_output", "bias_conversion", "result_data_type", "result_conversion"],
      "properties": {
        "classifier_profile": {"type": "string", "enum": ["integer_matrix_multiply"]},
        "product_data_type": {"type": "string", "minLength": 1, "description": "Declared integer data type wide enough for an exact product."},
        "accumulator_data_type": {"type": "string", "minLength": 1},
        "accumulator_initialization": {"type": "integer", "enum": [0]},
        "reduction_dimensions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
        "reduction_order": {"type": "string", "enum": ["increasing_declared_reduction_coordinate"]},
        "reduction_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement_after_each_add"]},
        "post_operations": {
          "type": "object",
          "description": "A DAG of named post-reduction stages, not a fixed order. Each stage names exactly one predecessor via depends_on -- either the literal string 'accumulator' or another stage's key -- so execution order is derived by following depends_on edges back from post_output, not by object-key order. Empty object means no post-processing at all (post_output must then be 'accumulator'). Built-in stages may be combined with formula-defined stages. A formula-defined stage is accepted by the Contract Reviewer only when the deterministic solver compiler can translate it; otherwise the Architect revises it or explicitly requests llm_extension.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "depends_on", "data_object", "broadcast_dimensions"],
                "properties": {
                  "kind": {"type": "string", "enum": ["bias_add"]},
                  "depends_on": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
                  "data_object": {"type": "string", "minLength": 1},
                  "broadcast_dimensions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "depends_on", "data_type"],
                "properties": {
                  "kind": {"type": "string", "enum": ["wrap"]},
                  "depends_on": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
                  "data_type": {"type": "string", "minLength": 1}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "depends_on"],
                "properties": {
                  "kind": {"type": "string", "enum": ["relu"]},
                  "depends_on": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "depends_on", "scale_multiplier", "scale_shift", "zero_point", "data_type", "rounding", "saturation", "granularity"],
                "properties": {
                  "kind": {"type": "string", "enum": ["affine_quantize"]},
                  "depends_on": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
                  "scale_multiplier": {"type": "integer", "minimum": 1, "maximum": 2147483647, "description": "Positive numerator of the fixed-point affine scale."},
                  "scale_shift": {"type": "integer", "minimum": 0, "maximum": 62, "description": "Power-of-two denominator: effective scale is scale_multiplier / 2^scale_shift."},
                  "zero_point": {"type": "integer"},
                  "data_type": {"type": "string", "minLength": 1},
                  "rounding": {"type": "string", "enum": ["nearest_ties_to_even"]},
                  "saturation": {"type": "string", "enum": ["clamp"]},
                  "granularity": {"type": "string", "enum": ["per_tensor"]}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "depends_on", "formula"],
                "properties": {
                  "kind": {"type": "string", "enum": ["llm_defined"]},
                  "depends_on": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
                  "formula": {
                    "type": "string", "minLength": 1, "maxLength": 4096,
                    "description": "A deterministic integer expression over 'value', the scalar entering this DAG stage. The Contract Reviewer decides representability by invoking the solver compiler rather than by matching a contract-level operator list. The same compiled expression drives symbolic solving and concrete golden evaluation."
                  }
                }
              }
            ]
          }
        },
        "post_output": {
          "type": "string", "minLength": 1,
          "description": "The stage (key in post_operations) or the literal 'accumulator' whose output feeds result_conversion."
        },
        "bias_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement_after_add"]},
        "result_data_type": {"type": "string", "minLength": 1},
        "result_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement"]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["classifier_profile", "score_product_data_type", "score_accumulator_data_type", "score_accumulator_initialization", "score_reduction_dimensions", "score_reduction_order", "score_reduction_conversion", "result_data_type", "result_conversion"],
      "properties": {
        "classifier_profile": {"type": "string", "enum": ["integer_qk_score"]},
        "score_product_data_type": {"type": "string", "minLength": 1, "description": "Declared integer data type wide enough for every exact Q*K product."},
        "score_accumulator_data_type": {"type": "string", "minLength": 1},
        "score_accumulator_initialization": {"type": "integer", "enum": [0]},
        "score_reduction_dimensions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
        "score_reduction_order": {"type": "string", "enum": ["increasing_declared_reduction_coordinate"]},
        "score_reduction_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement_after_each_add"]},
        "result_data_type": {"type": "string", "minLength": 1},
        "result_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement"]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["classifier_profile", "head_dimension", "coefficient_derivation", "scale_multiplier", "scale_shift", "rounding", "product_data_type", "result_data_type", "result_conversion"],
      "properties": {
        "classifier_profile": {"type": "string", "enum": ["fixed_point_attention_scale"]},
        "head_dimension": {"type": "string", "minLength": 1, "description": "Declared fixed feature dimension D used to derive 1/sqrt(D)."},
        "coefficient_derivation": {"type": "string", "enum": ["round_inverse_sqrt"], "description": "scale_multiplier must equal round(2^scale_shift/sqrt(D)), with positive half values rounded upward."},
        "scale_multiplier": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "scale_shift": {"type": "integer", "minimum": 0, "maximum": 62},
        "rounding": {"type": "string", "enum": ["arithmetic_floor"], "description": "Signed exact product is divided by 2^scale_shift using arithmetic-right-shift/floor semantics."},
        "product_data_type": {"type": "string", "minLength": 1, "description": "Declared signed integer type wide enough for every exact score*scale_multiplier product."},
        "result_data_type": {"type": "string", "minLength": 1},
        "result_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement"]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["classifier_profile", "mask_mode", "result_data_type", "result_conversion"],
      "properties": {
        "classifier_profile": {"type": "string", "enum": ["binary_attention_mask"]},
        "mask_mode": {"type": "string", "enum": ["binary_keep"], "description": "One preserves the coordinate's scaled score; zero replaces it with zero."},
        "result_data_type": {"type": "string", "minLength": 1},
        "result_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement"]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["classifier_profile", "score_product_data_type", "score_accumulator_data_type", "score_accumulator_initialization", "score_reduction_dimensions", "score_reduction_order", "score_reduction_conversion", "scaling", "mask_mode", "normalization", "output_product_data_type", "output_accumulator_data_type", "output_accumulator_initialization", "output_reduction_dimensions", "output_reduction_order", "output_reduction_conversion", "result_data_type", "result_conversion"],
      "properties": {
        "classifier_profile": {"type": "string", "enum": ["integer_sparse_attention"]},
        "score_product_data_type": {"type": "string", "minLength": 1, "description": "Declared integer data type wide enough for every exact Q*K product."},
        "score_accumulator_data_type": {"type": "string", "minLength": 1},
        "score_accumulator_initialization": {"type": "integer", "enum": [0]},
        "score_reduction_dimensions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
        "score_reduction_order": {"type": "string", "enum": ["increasing_declared_reduction_coordinate"]},
        "score_reduction_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement_after_each_add"]},
        "scaling": {"type": "string", "enum": ["none"], "description": "Explicit identity scaling for this restricted composition. Reciprocal-square-root scaling belongs to a separate supported stage/profile."},
        "mask_mode": {"type": "string", "enum": ["binary_keep"]},
        "normalization": {"type": "string", "enum": ["none"], "description": "The first code-owned sparse-attention profile is exact unnormalized masked dot-product attention. Softmax, scaling, top-k selection, and approximate normalization require a separate supported profile or llm_extension."},
        "output_product_data_type": {"type": "string", "minLength": 1, "description": "Declared integer data type wide enough for every exact score*V product."},
        "output_accumulator_data_type": {"type": "string", "minLength": 1},
        "output_accumulator_initialization": {"type": "integer", "enum": [0]},
        "output_reduction_dimensions": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 1},
        "output_reduction_order": {"type": "string", "enum": ["increasing_declared_reduction_coordinate"]},
        "output_reduction_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement_after_each_add"]},
        "result_data_type": {"type": "string", "minLength": 1},
        "result_conversion": {"type": "string", "enum": ["exact", "wrap_twos_complement"]}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["classifier_profile", "reason"],
      "properties": {
        "classifier_profile": {"type": "string", "enum": ["llm_extension"]},
        "reason": {"type": "string", "minLength": 1, "description": "Name the unsupported mathematical behavior. Exact semantics remain in operations[].semantics; no code-owned arithmetic is inferred for this profile."},
        "extension_request": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "description": "Optional exact link to the operation-domain verification_extensions request that owns this unsupported arithmetic. Omitted only for legacy coarse llm_extension contracts."}
      }
    }
  ]
}
