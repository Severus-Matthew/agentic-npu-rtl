{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-npu-rtl.local/schemas/verification-extension-request.schema.json",
  "title": "Architect Verification Extension Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "domain",
    "feature_name",
    "target",
    "semantics",
    "reason",
    "required_observations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "domain": {
      "type": "string",
      "enum": ["protocol", "lifecycle", "operation"]
    },
    "feature_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "name"],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "interface",
            "protocol_group",
            "channel",
            "signal",
            "operation",
            "data_object"
          ]
        },
        "name": {"type": "string", "minLength": 1}
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "trigger", "required_behavior", "end_condition"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "required_behavior": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "end_condition": {"type": "string", "minLength": 1},
        "forbidden_behavior": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "integer", "number", "boolean", "null"]
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "name"],
            "properties": {
              "source": {"enum": ["builtin", "contract_local"]},
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
            }
          }
        },
        "required_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_semantic_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "required_protocol_profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "contract_vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "name", "definition"],
      "properties": {
        "pool": {
          "type": "string",
          "enum": ["signal_role", "semantic_class"]
        },
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "coverage_tags"],
          "properties": {
            "description": {"type": "string", "minLength": 1},
            "coverage_tags": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            },
            "category": {"type": ["string", "null"]},
            "channel_binding": {
              "type": ["string", "null"],
              "enum": ["required", "optional", "forbidden", null]
            },
            "direction_relation": {
              "type": ["string", "null"],
              "enum": ["fixed", "same_as_channel", "opposite_to_channel", null]
            },
            "allowed_directions": {
              "type": "array",
              "items": {"type": "string", "enum": ["input", "output"]},
              "uniqueItems": true
            },
            "semantic_class_binding": {
              "type": ["string", "null"],
              "enum": ["required", "optional", "forbidden", null]
            },
            "allowed_roles": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "replaces_contract_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^/"}
    },
    "required_observations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "description"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "kind": {
            "type": "string",
            "enum": ["signal", "event", "transaction", "logical_value", "golden_trace", "configuration"]
          },
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "related_builtin_features": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
