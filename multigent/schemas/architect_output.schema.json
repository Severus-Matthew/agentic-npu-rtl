{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architect Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "conflicts",
    "architecture_contract",
    "interface_contract",
    "module_manifest",
    "acceptance_criteria"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["READY", "SPEC_CONFLICT"]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_a", "requirement_b", "reason", "recommended_resolution"],
        "properties": {
          "requirement_a": {"type": "string"},
          "requirement_b": {"type": "string"},
          "reason": {"type": "string"},
          "recommended_resolution": {"type": "string"}
        }
      }
    },
    "architecture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "operation",
        "numeric",
        "compute",
        "dataflow",
        "pipeline",
        "buffers",
        "control",
        "reset",
        "latency_model",
        "architectural_invariants",
        "open_assumptions"
      ],
      "properties": {
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "description"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "description": {"type": "string"}
          }
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "equation", "description"],
          "properties": {
            "kind": {"type": "string"},
            "equation": {"type": "string"},
            "description": {"type": "string"}
          }
        },
        "numeric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activation_width",
            "activation_signed",
            "weight_width",
            "weight_signed",
            "accumulator_width",
            "accumulator_signed",
            "overflow_semantics",
            "rounding_semantics"
          ],
          "properties": {
            "activation_width": {"type": "integer", "minimum": 1},
            "activation_signed": {"type": "boolean"},
            "weight_width": {"type": "integer", "minimum": 1},
            "weight_signed": {"type": "boolean"},
            "accumulator_width": {"type": "integer", "minimum": 1},
            "accumulator_signed": {"type": "boolean"},
            "overflow_semantics": {"type": "string"},
            "rounding_semantics": {"type": "string"}
          }
        },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["organization", "rows", "columns", "mac_count", "parameterization"],
          "properties": {
            "organization": {"type": "string"},
            "rows": {"type": "integer", "minimum": 1},
            "columns": {"type": "integer", "minimum": 1},
            "mac_count": {"type": "integer", "minimum": 1},
            "parameterization": {"type": "string"}
          }
        },
        "dataflow": {"type": "string"},
        "pipeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "responsibility", "registered", "valid_behavior"],
            "properties": {
              "stage": {"type": "string"},
              "responsibility": {"type": "string"},
              "registered": {"type": "boolean"},
              "valid_behavior": {"type": "string"}
            }
          }
        },
        "buffers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "implementation_hint", "depth", "element_width"],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"},
              "implementation_hint": {"type": "string"},
              "depth": {"type": "integer", "minimum": 1},
              "element_width": {"type": "integer", "minimum": 1}
            }
          }
        },
        "control": {"type": "string"},
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "polarity", "required_state"],
          "properties": {
            "style": {"type": "string"},
            "polarity": {"type": "string"},
            "required_state": {"type": "string"}
          }
        },
        "latency_model": {"type": "string"},
        "architectural_invariants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "open_assumptions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "interface_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "clock", "reset", "signals", "handshake"],
      "properties": {
        "protocol": {"type": "string"},
        "clock": {"type": "string"},
        "reset": {"type": "string"},
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "direction", "width", "signed", "semantic", "reset_value"],
            "properties": {
              "name": {"type": "string"},
              "direction": {"type": "string", "enum": ["input", "output"]},
              "width": {"type": "string"},
              "signed": {"type": "boolean"},
              "semantic": {"type": "string"},
              "reset_value": {"type": "string"}
            }
          }
        },
        "handshake": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transfer_condition", "stall_behavior", "backpressure_supported", "ordering"],
          "properties": {
            "transfer_condition": {"type": "string"},
            "stall_behavior": {"type": "string"},
            "backpressure_supported": {"type": "boolean"},
            "ordering": {"type": "string"}
          }
        }
      }
    },
    "module_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "modules"],
      "properties": {
        "top": {"type": "string"},
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "responsibility", "dependencies", "stateful"],
            "properties": {
              "name": {"type": "string"},
              "responsibility": {"type": "string"},
              "dependencies": {"type": "array", "items": {"type": "string"}},
              "stateful": {"type": "boolean"}
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "verification", "rtl", "synopsys_handoff"],
      "properties": {
        "functional": {"type": "array", "items": {"type": "string"}},
        "verification": {"type": "array", "items": {"type": "string"}},
        "rtl": {"type": "array", "items": {"type": "string"}},
        "synopsys_handoff": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
