{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generic Architect Agent Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "conflicts",
    "architecture_contract",
    "interface_contract",
    "module_manifest",
    "acceptance_criteria"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["READY", "SPEC_CONFLICT"]
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_a", "requirement_b", "reason", "recommended_resolution"],
        "properties": {
          "requirement_a": {"type": "string"},
          "requirement_b": {"type": "string"},
          "reason": {"type": "string"},
          "recommended_resolution": {"type": "string"}
        }
      }
    },
    "architecture_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "design",
        "operations",
        "data_types",
        "data_objects",
        "dimensions",
        "parameters",
        "compute",
        "storage",
        "pipeline",
        "control",
        "reset",
        "latency_model",
        "architectural_invariants",
        "open_assumptions"
      ],
      "properties": {
        "design": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "description"],
          "properties": {
            "name": {"type": "string"},
            "version": {"type": "string"},
            "description": {"type": "string"}
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind", "semantics", "inputs", "outputs"],
            "properties": {
              "name": {"type": "string"},
              "kind": {"type": "string"},
              "semantics": {"type": "string"},
              "inputs": {"type": "array", "items": {"type": "string"}},
              "outputs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "data_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "width_bits",
              "signed",
              "representation",
              "conversion_semantics",
              "overflow_semantics",
              "rounding_semantics"
            ],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"},
              "width_bits": {"type": "integer", "minimum": 1},
              "signed": {"type": "boolean"},
              "representation": {"type": "string"},
              "conversion_semantics": {"type": "string"},
              "overflow_semantics": {"type": "string"},
              "rounding_semantics": {"type": "string"}
            }
          }
        },
        "data_objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "data_type",
              "dimensions",
              "producer",
              "consumers",
              "external"
            ],
            "properties": {
              "name": {"type": "string"},
              "role": {"type": "string"},
              "data_type": {"type": "string"},
              "dimensions": {"type": "array", "items": {"type": "string"}},
              "producer": {"type": "string"},
              "consumers": {"type": "array", "items": {"type": "string"}},
              "external": {"type": "boolean"}
            }
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "semantic",
              "minimum",
              "maximum",
              "runtime_configurable",
              "bound_parameter"
            ],
            "properties": {
              "name": {"type": "string"},
              "semantic": {"type": "string"},
              "minimum": {"type": "integer", "minimum": 0},
              "maximum": {"type": "integer", "minimum": 1},
              "runtime_configurable": {"type": "boolean"},
              "bound_parameter": {"type": "string"}
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "default_value", "legality_constraint", "description"],
            "properties": {
              "name": {"type": "string"},
              "default_value": {"type": "string"},
              "legality_constraint": {"type": "string"},
              "description": {"type": "string"}
            }
          }
        },
        "compute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["organization", "dataflow", "parallelism", "scheduling"],
          "properties": {
            "organization": {"type": "string"},
            "dataflow": {"type": "string"},
            "parallelism": {"type": "string"},
            "scheduling": {"type": "string"}
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "stored_objects",
              "capacity_expression",
              "capacity_at_default_parameters",
              "access_pattern",
              "port_requirements",
              "implementation_hint",
              "reuse_semantics",
              "lifetime"
            ],
            "properties": {
              "name": {"type": "string"},
              "stored_objects": {"type": "array", "items": {"type": "string"}},
              "capacity_expression": {"type": "string"},
              "capacity_at_default_parameters": {"type": "integer", "minimum": 1},
              "access_pattern": {"type": "string"},
              "port_requirements": {"type": "string"},
              "implementation_hint": {"type": "string"},
              "reuse_semantics": {"type": "string"},
              "lifetime": {"type": "string"}
            }
          }
        },
        "pipeline": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "responsibility", "registered", "valid_behavior", "stall_behavior"],
            "properties": {
              "stage": {"type": "string"},
              "responsibility": {"type": "string"},
              "registered": {"type": "boolean"},
              "valid_behavior": {"type": "string"},
              "stall_behavior": {"type": "string"}
            }
          }
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "state_progression", "counters", "error_behavior", "error_recovery"],
          "properties": {
            "strategy": {"type": "string"},
            "state_progression": {"type": "string"},
            "counters": {"type": "array", "items": {"type": "string"}},
            "error_behavior": {"type": "string"},
            "error_recovery": {"type": "string"}
          }
        },
        "reset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["style", "polarity", "required_state"],
          "properties": {
            "style": {"type": "string"},
            "polarity": {"type": "string"},
            "required_state": {"type": "string"}
          }
        },
        "latency_model": {"type": "string"},
        "architectural_invariants": {
          "type": "array",
          "items": {"type": "string"}
        },
        "open_assumptions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "interface_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "clock", "reset", "channels", "signals", "global_handshake_rules"],
      "properties": {
        "protocol": {"type": "string"},
        "clock": {"type": "string"},
        "reset": {"type": "string"},
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "direction",
              "purpose",
              "data_objects",
              "metadata",
              "framing",
              "ordering",
              "backpressure"
            ],
            "properties": {
              "name": {"type": "string"},
              "direction": {"type": "string", "enum": ["input", "output"]},
              "purpose": {"type": "string"},
              "data_objects": {"type": "array", "items": {"type": "string"}},
              "metadata": {"type": "array", "items": {"type": "string"}},
              "framing": {"type": "string"},
              "ordering": {"type": "string"},
              "backpressure": {"type": "string"}
            }
          }
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "direction", "width", "signed", "semantic", "reset_value"],
            "properties": {
              "name": {"type": "string"},
              "direction": {"type": "string", "enum": ["input", "output"]},
              "width": {"type": "string"},
              "signed": {"type": "boolean"},
              "semantic": {"type": "string"},
              "reset_value": {"type": "string"}
            }
          }
        },
        "global_handshake_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transfer_condition", "stall_behavior"],
          "properties": {
            "transfer_condition": {"type": "string"},
            "stall_behavior": {"type": "string"}
          }
        }
      }
    },
    "module_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "modules"],
      "properties": {
        "top": {"type": "string"},
        "modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "responsibility", "dependencies", "parameters", "stateful"],
            "properties": {
              "name": {"type": "string"},
              "responsibility": {"type": "string"},
              "dependencies": {"type": "array", "items": {"type": "string"}},
              "parameters": {"type": "array", "items": {"type": "string"}},
              "stateful": {"type": "boolean"}
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "verification", "rtl", "synopsys_handoff"],
      "properties": {
        "functional": {"type": "array", "items": {"type": "string"}},
        "verification": {"type": "array", "items": {"type": "string"}},
        "rtl": {"type": "array", "items": {"type": "string"}},
        "synopsys_handoff": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
