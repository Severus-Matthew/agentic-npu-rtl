{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure Diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "failure_class",
    "root_cause",
    "root_cause_domain",
    "cause_ranking",
    "confidence",
    "first_divergence",
    "evidence",
    "affected_modules",
    "alternative_hypotheses",
    "additional_evidence_requested"
  ],
  "properties": {
    "failure_class": {"type": "string"},
    "root_cause": {"type": "string"},
    "root_cause_domain": {
      "type": "string",
      "enum": ["RTL_DESIGN", "GOLDEN_MODEL", "LLM_OPERATION_ASSERTION", "TESTBENCH_INFRASTRUCTURE", "CONTRACT_GENERATED_PROTOCOL_ASSERTION"]
    },
    "cause_ranking": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "priority", "assessment", "evidence"],
        "properties": {
          "domain": {"type": "string", "enum": ["RTL_DESIGN", "GOLDEN_MODEL", "LLM_OPERATION_ASSERTION", "TESTBENCH_INFRASTRUCTURE", "CONTRACT_GENERATED_PROTOCOL_ASSERTION"]},
          "priority": {"type": "integer", "minimum": 1, "maximum": 6},
          "assessment": {"type": "string", "enum": ["SUPPORTED", "ELIMINATED", "UNRESOLVED"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "first_divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "signal_or_output", "expected", "observed"],
      "properties": {
        "cycle": {"type": ["integer", "null"], "minimum": 0},
        "signal_or_output": {"type": "string"},
        "expected": {"type": "string"},
        "observed": {"type": "string"}
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "observation", "relevance"],
        "properties": {
          "source": {"type": "string"},
          "observation": {"type": "string"},
          "relevance": {"type": "string"}
        }
      }
    },
    "affected_modules": {"type": "array", "items": {"type": "string"}},
    "alternative_hypotheses": {"type": "array", "items": {"type": "string"}},
    "additional_evidence_requested": {"type": "array", "items": {"type": "string"}}
  }
}
