{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verifier Source Revision Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "patches",
    "metadata_edits",
    "architecture_conflict",
    "known_verification_gaps"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PATCH_READY", "ARCHITECTURE_CONFLICT"]
    },
    "summary": {"type": "string"},
    "patches": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "old_text", "new_text", "finding_indices", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "old_text": {"type": "string", "minLength": 1},
          "new_text": {"type": "string"},
          "finding_indices": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "metadata_edits": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "path", "value_json", "finding_indices", "reason"],
        "properties": {
          "op": {"type": "string", "enum": ["add", "replace"]},
          "path": {"type": "string", "minLength": 1},
          "value_json": {"type": "string"},
          "finding_indices": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "integer", "minimum": 0}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "architecture_conflict": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["category", "affected_modules", "issue", "evidence", "requested_architect_decision"],
      "properties": {
        "category": {"type": "string"},
        "affected_modules": {"type": "array", "items": {"type": "string"}},
        "issue": {"type": "string"},
        "evidence": {"type": "string"},
        "requested_architect_decision": {"type": "string"}
      }
    },
    "known_verification_gaps": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
