{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "findings"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REVISION_REQUIRED"
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_path",
          "issue",
          "requested_change"
        ],
        "properties": {
          "contract_path": {
            "type": "string",
            "minLength": 1
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "requested_change": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
